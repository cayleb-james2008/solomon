{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotz.dev/contracts/browser-observation.v1.schema.json",
  "title": "Monitored Pi browser observation v1",
  "type": "object",
  "required": ["schemaVersion", "sessionId", "seq", "status", "owner", "page", "elements", "consoleErrors", "networkErrors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["starting", "ready", "acting", "done", "error", "stopped"] },
    "owner": {
      "type": "object",
      "required": ["projectId"],
      "properties": {
        "app": { "type": "string" },
        "projectId": { "type": "string" },
        "workflowId": { "type": "string" },
        "stepId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["url", "title", "viewport"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "role", "name", "observationSeq"],
        "properties": {
          "ref": { "type": "string", "pattern": "^e[0-9]+$" },
          "role": { "type": "string" },
          "name": { "type": "string" },
          "observationSeq": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "cursor": {
      "type": "object",
      "required": ["x", "y", "kind"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "kind": { "type": "string" }
      }
    },
    "currentAction": { "type": "object" },
    "frame": {
      "type": "object",
      "required": ["seq", "mime", "available"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "mime": { "const": "image/jpeg" },
        "available": { "const": true }
      }
    },
    "consoleErrors": { "type": "array", "items": { "type": "string" } },
    "networkErrors": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
