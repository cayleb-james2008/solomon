# PyInstaller build output
dist/
build/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# operator runtime + secrets (per-machine, not source)
runtime/
# per-operator improver state (backlog + lessons churn per machine, like runtime/)
improver/*/backlog.md
improver/*/LESSONS.md
# test-only default-name ("repo") contract scratch; recreated by the e2e suite, no managed repo uses it
improver/repo/
# test-scratch working dirs (2026-07-07 audit A.6): the supervisor/watchdog/budget suites write
# PID-suffixed scratch dirs into the live improver/ + runtime/ trees. runtime/ is already ignored
# above; these prefixes keep the improver/ (and any stray top-level) copies out of `git status
# --porcelain` so they can NEVER trip the controller-clean gate (catalog #6). The janitor reaps the
# aged copies for storage hygiene; this keeps them invisible to git the instant they are created.
sup_test_*/
testrepo_*/
wd_ar_*/
wd_heal_*/
wd_stall_*/
app_test_*/
.env
.solomon.json
.rsi-control.json

# defensive secret/cred + heavy-artifact coverage (most are absent in this pure-Rust
# repo today, but pinned so they can NEVER be committed if a tool/lane creates them)
config.json
.state/
.venv/
node_modules/
target/
*.key
*.pem

# managed-repo clones an operator may relocate under Solomon (repos.json path -> repos/<name>);
# these are NOT Solomon source — keep them out of git and out of Solomon's own pytest collection
repos/

# generated icon verification scratch (icon.ico / icon.png are kept)
web/assets/_exe_icon_verify.png

# Rust build output (the exe is built from src-tauri/ and shipped via the release workflow)
/Solomon.exe
# transient backup when overwriting a locked (running) Solomon.exe — rename-aside then copy
/Solomon.exe.old

# transient rename-aside artifacts while a running/recorded exe is being swapped
/Solomon.exe.*
