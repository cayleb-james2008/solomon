# Solomon v2 .env — operator-local secrets; never committed.
# Copy to .env and fill in. All keys are optional unless you want live mode.

# --- Main LLM (OpenAI-compatible) ---
# Cloud GLM-5.2 (default), OpenRouter, or local Ornith via Lemonade
SOLOMON_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SOLOMON_LLM_API_KEY=
SOLOMON_LLM_MODEL=glm-4-flash

# --- VLM fallback (when main LLM is text-only) ---
# MiniCPM-V-2.6 via llama.cpp on localhost, or cloud vision via OpenRouter
SOLOMON_VLM_BASE_URL=http://localhost:8012/v1
SOLOMON_VLM_API_KEY=sk-no-key-needed
SOLOMON_VLM_MODEL=MiniCPM-V-2.6
# Fallback: cloud vision
# SOLOMON_VLM_BASE_URL=https://openrouter.ai/api/v1
# SOLOMON_VLM_API_KEY=
# SOLOMON_VLM_MODEL=google/gemini-flash-1.5

# --- Browser stealth ---
# Profile directory for persistent login sessions (Fiverr, Medium, Prolific, etc.)
SOLOMON_BROWSER_PROFILE=./runtime/browser-profile
# Headless mode (false = visible browser window, better for debugging/anti-bot)
SOLOMON_BROWSER_HEADLESS=false
# User agent override (empty = PatchRight default)
SOLOMON_BROWSER_UA=

# --- Income channels ---
# Toggle channels on/off
SOLOMON_CHANNEL_FREELANCE=true
SOLOMON_CHANNEL_CONTENT=true
SOLOMON_CHANNEL_MICROTASK=true
SOLOMON_CHANNEL_AI_WRAPPER=true

# Auto-submit gate — DANGER: false = draft only (safe), true = auto-submit public content
# Start with false; flip to true per-channel after operator trust is established
SOLOMON_AUTO_SUBMIT=false

# --- CEO loop ---
# How many cycles to run (0 = infinite loop with sleep between cycles)
SOLOMON_MAX_CYCLES=1
# Seconds between cycles
SOLOMON_CYCLE_SLEEP=300

# --- Content publishing (optional — for Dev.to auto-publish) ---
# Get a free API key at https://dev.to/settings/extensions
DEVTO_API_KEY=

# --- Notifications (optional) ---
# ntfy.sh topic for operator alerts (CAPTCHAs, approvals, revenue events)
SOLOMON_NTFY_TOPIC=
