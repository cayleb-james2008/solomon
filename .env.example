# Solomon v2 .env — operator-local secrets/config. Gitignored; never commit.
# Copy to `.env` at the repo root. Lines are KEY=VALUE; quotes optional.

# --- LLM brain (any OpenAI-compatible endpoint) ---
# Cloud interim (today): OpenRouter.
# STANDALONE ENDGAME — local Ornith-35B via Lemonade (flip = these 3 lines, no code change):
#   SOLOMON_LLM_BASE_URL=http://localhost:13305/api/v1
#   SOLOMON_LLM_API_KEY=sk-no-key
#   SOLOMON_LLM_MODEL=Ornith-1.0-35B-GGUF-UD-Q8_K_XL
SOLOMON_LLM_BASE_URL=https://openrouter.ai/api/v1
SOLOMON_LLM_API_KEY=
SOLOMON_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Channels/improver lanes that read OpenRouter directly:
OPENROUTER_API_KEY=

# --- VLM (vision fallback). Ornith doubles as the local VLM on :13305 ---
SOLOMON_VLM_BASE_URL=https://openrouter.ai/api/v1
SOLOMON_VLM_API_KEY=
SOLOMON_VLM_MODEL=google/gemini-2.5-flash

# --- Dev.to publishing (content channel) ---
# Get key at dev.to/settings/extensions. API quirk: per_page>30 returns 401.
DEVTO_API_KEY=
SOLOMON_AUTO_SUBMIT=true

# --- Stripe rail (money-IN only — never refunds/payouts) ---
# Test keys first; swap to sk_live_ after account activation.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Cloudflare workers deploys ---
# Account-owned token (cfat_ prefix). Verify with:
#   curl -H "Authorization: Bearer $CF_API_TOKEN" \
#     https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT_ID/tokens/verify
# (The /user/tokens/verify endpoint falsely rejects account-owned tokens.)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_SUBDOMAIN=solomontools

# --- CEO loop ---
SOLOMON_MAX_CYCLES=1
SOLOMON_CYCLE_SLEEP=300
# SOLOMON_CHANNEL_CONTENT=true / FREELANCE / MICROTASK / AI_WRAPPER / GITHUB_PAGES

# --- Operator notifications (optional; ntfy.sh topic) ---
SOLOMON_NTFY_TOPIC=
