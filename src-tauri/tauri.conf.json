{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solomon",
  "version": "0.1.0",
  "identifier": "com.cayleb.solomon",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cayleb-james2008/solomon/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMEU2MDY3QkRDOTE3NkMKUldSc0Y4bTlaMkFPekdYb3lCeURENm5sUkF6T09GV0NqL0VBVkFNaWl4K1JxK0xWVUZDaTZsVnUK"
    }
  }
}
