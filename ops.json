                "file": "runtime\\_monitor.jsonl",
                "field": "ts",
                "mode": "age",
                "yellow_after_s": 600,
                "red_after_s": 1800,
                "comment": "The watchdog appends here every ~2min while Solomon.exe is open; stale while the app is closed is the honest blind-window signal."
            }
        ]
    }
]
